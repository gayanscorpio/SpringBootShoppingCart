scalar BigDecimal

type Product {
  id: ID!
  name: String!
  description: String
  price: BigDecimal!
  sku: String
}

input CreateProductInput {
  name: String!
  description: String
  price: BigDecimal!
  sku: String
}

type CartItem {
  id: ID!
  product: Product!
  quantity: Int!
}

type Cart {
  id: ID!
  userId: String!
  items: [CartItem!]!
}

input AddToCartInput {
  productId: ID!
  quantity: Int = 1
}

input UpdateProductInput {
  name: String
  description: String
  price: BigDecimal
  sku: String
}

type Query {
  products: [Product]
  productById(id: ID!): Product
  cart(userId: String!): Cart
  hello: String
  testProducts: [TestProduct]
}

type Mutation {
  createProduct(input: CreateProductInput!): Product
  updateProduct(id: ID!, input: UpdateProductInput!): Product
  deleteProduct(id: ID!): Boolean
  addToCart(userId: String!, input: AddToCartInput!): Cart
  removeFromCart(userId: String!, productId: ID!): Cart
}

type Subscription {
  productAdded: Product
  expensiveProducts: Product
}

type TestProduct {
  id: ID!
  name: String!
  price: Float!
}
